{
  "name": "@voidaccess/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts",
    "./migrate": "./src/migrate.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "db:setup-dev": "tsx src/dev-setup.ts"
  },
  "dependencies": {
    "@voidaccess/config": "workspace:*",
    "@voidaccess/engine-client": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "google-auth-library": "^11.2.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.0",
    "better-auth": "^1.7.7",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  }
}
