# All optional in development. See env.ts.
# Two logins (docs/DATA-MODEL.md §3): the app login (RLS applies, cannot escalate) and the system login.
# `pnpm --filter @voidaccess/db db:setup-dev` prints both URLs for a local database.
# DATABASE_URL=postgres://va_app:pass@localhost:5432/voidaccess
# DATABASE_URL_SYSTEM=postgres://va_worker:pass@localhost:5432/voidaccess
# Signs the tenant context. Production requires >= 32 random characters, identical to the key installed in the
# database (app_ctx_key). Unset outside production uses the development key that db:setup-dev installs.
# RLS_CONTEXT_KEY=
# APP_URL=http://localhost:3000
# Sign in with Google / Microsoft (each provider is on only when both values are set)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# Real client IP header for auth rate limits (cf-connecting-ip behind Cloudflare, x-forwarded-for behind Google)
# AUTH_IP_HEADER=
