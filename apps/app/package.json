    "screenshots:results": "node scripts/results-screenshots.mjs",
    "admin:grant-role": "tsx scripts/admin-grant-role.ts",
    "dodo:sync": "tsx scripts/dodo-sync.ts",
    "billing:checkout-smoke": "tsx scripts/dodo-checkout-smoke.ts",
    "test:e2e:billing": "playwright test -c playwright.billing.config.ts",
    "test:e2e:archive": "playwright test -c playwright.archive.config.ts",
    "test:e2e:ops": "playwright test -c playwright.ops.config.ts"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.15",
    "@voidaccess/archive": "workspace:*",
    "@voidaccess/config": "workspace:*",
    "@voidaccess/db": "workspace:*",
    "@voidaccess/emails": "workspace:*",
    "@voidaccess/engine-client": "workspace:*",
    "@voidaccess/engine-mock": "workspace:*",
    "@voidaccess/ingest": "workspace:*",
    "@voidaccess/ui": "workspace:*",
    "better-auth": "^1.7.7",
    "dodopayments": "^2.54.2",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "next": "^16.4.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "sigma": "^3.0.3",
    "three": "0.186.1",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "~0.186.0",
    "graphology-types": "^0.24.8",
    "jsdom": "^30.1.2",
