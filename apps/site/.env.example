# Local development (see README). Never commit real values.
DATABASE_URL=postgres://localhost:5432/voidaccess_site_dev
SITE_URL=http://localhost:3100
# Cloudflare Turnstile test keys (always pass). Real keys come from Secret Manager in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
IP_HASH_SALT=dev-only-salt
# unset = log transport (dev/test)
RESEND_API_KEY=
EMAIL_FROM=

# Auth pages talk to Better Auth on the app domain (cross-domain cookies).
# Default is https://app.voidaccess.pro. For local dev run the app on :3600 and use:
NEXT_PUBLIC_APP_URL=http://app.va.localhost:3600
# Minimal mode (home + auth + legal only; no DB, no Resend): `pnpm dev:minimal` on :3700.
# Set SITE_URL=http://localhost:3700 (or http://va.localhost:3700) for it; none of the secrets above are needed.
# SITE_MODE=minimal
