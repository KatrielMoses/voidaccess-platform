{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voidaccess-site",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Non-secret config. Secrets (DATABASE_URL, RESEND_API_KEY, TURNSTILE_SECRET_KEY, IP_HASH_SALT)
  // are uploaded by scripts/deploy.sh and never live in this file.
  "vars": {
    "SITE_URL": "https://voidaccess.pro",
    "DB_DRIVER": "neon",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
  },
  // Shared per-IP burst limiter for POST /api/waitlist (5 requests / 60 s). The daily cap is enforced in the DB.
  "ratelimits": [{ "name": "WAITLIST_RL", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }]
}
