{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voidaccess-site",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Production config for SITE_MODE=minimal (auth + legal pages + placeholder home). No secrets, no database, no bindings.
  // The full marketing site + waitlist uses wrangler.full.jsonc (see scripts/deploy.sh). Both deploy the same Worker name.
  // Workers custom domains in the voidaccess.pro zone; www is served only to redirect to the bare host (src/proxy.ts).
  "routes": [
    { "pattern": "voidaccess.pro", "custom_domain": true },
    { "pattern": "www.voidaccess.pro", "custom_domain": true }
  ],
  // Non-secret config. NEXT_PUBLIC_* and SITE_MODE are inlined at build time by scripts/deploy.sh; they are repeated here
  // so the running Worker reports the same values.
  "vars": {
    "SITE_URL": "https://voidaccess.pro",
    "NEXT_PUBLIC_APP_URL": "https://app.voidaccess.pro",
    "SITE_MODE": "minimal"
  }
}
